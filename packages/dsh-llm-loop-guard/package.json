{
  "name": "dsh-llm-loop-guard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "index.js",
  "description": "Abort degenerate repetition in an LLM stream and let the retry executor replay the step",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "scripts": {
    "test": "node test/test-loop-guard.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  }
}
