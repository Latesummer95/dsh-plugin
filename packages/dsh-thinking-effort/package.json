{
  "name": "dsh-thinking-effort",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "index.js",
  "description": "Adds thinking-effort levels (and the adaptive-thinking compat flag) to every anthropic-messages provider route at runtime, with a Settings switch that turns it off without restarting DSH",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "scripts": {
    "test": "node test/test-augment.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  }
}
